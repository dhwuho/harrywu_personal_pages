# Security headers for the CMS. The page holds a GitHub token, so it may only talk to
# this site and GitHub. 'unsafe-eval' is needed by the live MDX preview (it compiles code).
/admin/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://raw.githubusercontent.com https://i.ytimg.com; connect-src 'self' https://api.github.com; frame-src https://www.youtube-nocookie.com https://player.bilibili.com; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Cache-Control: no-cache
