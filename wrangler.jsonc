{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "harrywu-personal-pages",
  "compatibility_date": "2026-10-06",
  // Handles /api/* only (CMS sign-in); everything else is static files from dist/.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Public values. The secret GITHUB_CLIENT_SECRET is set in the Cloudflare dashboard
  // (Worker → Settings → Variables and secrets → Secret), never in this file.
  "vars": {
    // GitHub App client ID (docs/setup-guide.md, step 4). Empty = sign-in disabled.
    "GITHUB_CLIENT_ID": "Iv23liB5KQiPAssQtfQT",
    // GitHub user ID allowed to sign in (dhwuho).
    "OWNER_ID": "5953718"
  },
  "observability": { "enabled": true }
}
