---
import type { ImageMetadata } from 'astro';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { mdxComponents } from '../../../components/mdx';
import { formatDate, htmlLang, localePath, localeStaticPaths, t, tagLabel, tagSlug, type Locale } from '../../../i18n';
import { getPostGroups, viewFor, type PostView } from '../../../lib/content';

export async function getStaticPaths() {
  // Every post gets a page in both languages; a missing translation falls back to the other version.
  const groups = await getPostGroups();
  return localeStaticPaths().flatMap(({ params, props }) =>
    groups.map((group) => ({
      params: { ...params, slug: group.slug },
      props: {
        ...props,
        view: viewFor(group, props.lang),
        // A cover set on either language version is used for both.
        cover: Object.values(group.versions).find((p) => p?.data.cover)?.data.cover,
      },
    })),
  );
}

const { lang, view, cover: sharedCover } = Astro.props as { lang: Locale; view: PostView; cover?: ImageMetadata };
const { post, postLang, isFallback, slug } = view;
const { Content } = await render(post);
const { title, description, date, updated, tags } = post.data;
---

<Base lang={lang} path={`/posts/${slug}`} title={title} description={description} image={post.data.cover ?? sharedCover} type="article">
  <article lang={isFallback ? htmlLang[postLang] : undefined}>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(lang, date)}</time>
        {updated && <span>· {t(lang, 'post.updated', { date: formatDate(lang, updated) })}</span>}
        {post.data.draft && <span class="tag">{t(lang, 'post.draft')}</span>}
      </p>
      {
        tags.length > 0 && (
          <p class="tags">
            {tags.map((tag) => (
              <a class="tag" href={localePath(lang, `/tags/${tagSlug(tag)}`)}>
                {tagLabel(lang, tag)}
              </a>
            ))}
          </p>
        )
      }
    </header>

    {
      isFallback && (
        <p class="fallback-note" lang={htmlLang[lang]}>
          {t(lang, 'post.onlyIn', { lang: t(lang, postLang === 'en' ? 'lang.en' : 'lang.zh') })}
        </p>
      )
    }

    <div class="prose">
      <Content components={mdxComponents} />
    </div>
  </article>
</Base>

<style>
  .post-header {
    margin: var(--space-12) 0 var(--space-8);
  }
  h1 {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-2);
  }
  .meta,
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .fallback-note {
    padding: var(--space-3) var(--space-4);
    background: var(--color-accent-soft);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    margin: 0 0 var(--space-8);
  }
</style>
