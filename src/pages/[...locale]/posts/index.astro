---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import TagFilter from '../../../components/TagFilter.astro';
import { localeStaticPaths, t, type Locale } from '../../../i18n';
import { collectTags, getPostViews } from '../../../lib/content';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
const views = await getPostViews(lang);
---

<Base lang={lang} path="/posts" title={t(lang, 'posts.title')} description={t(lang, 'posts.description')}>
  <h1 class="page-title">{t(lang, 'posts.title')}</h1>
  <p class="page-lead">{t(lang, 'posts.description')}</p>
  <TagFilter lang={lang} tags={collectTags(views)} />
  <PostList lang={lang} views={views} />
</Base>
