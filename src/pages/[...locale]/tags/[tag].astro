---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import TagFilter from '../../../components/TagFilter.astro';
import { localeStaticPaths, t, tagLabel, tagSlug, type Locale } from '../../../i18n';
import { collectTags, getPostViews } from '../../../lib/content';

export async function getStaticPaths() {
  // A tag page exists in both languages if any post version uses the tag.
  const all = new Map<string, string>();
  for (const { props } of localeStaticPaths()) {
    for (const { slug, tag } of collectTags(await getPostViews(props.lang))) {
      if (!all.has(slug)) all.set(slug, tag);
    }
  }
  return localeStaticPaths().flatMap(({ params, props }) =>
    [...all.entries()].map(([slug, tag]) => ({ params: { ...params, tag: slug }, props: { ...props, tag } })),
  );
}

const { lang, tag } = Astro.props as { lang: Locale; tag: string };
const slug = tagSlug(tag);
const views = await getPostViews(lang);
const tagged = views.filter(({ post }) => post.data.tags.some((name) => tagSlug(name) === slug));
const label = tagLabel(lang, tag);
---

<Base lang={lang} path={`/tags/${slug}`} title={label}>
  <h1 class="page-title">{t(lang, 'tag.title', { tag: label })}</h1>
  <TagFilter lang={lang} tags={collectTags(views)} current={slug} />
  <PostList lang={lang} views={tagged} />
</Base>
