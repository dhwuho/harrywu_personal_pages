---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { localePath, localeStaticPaths, t, type Locale } from '../../i18n';
import { getPostViews } from '../../lib/content';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
const recent = (await getPostViews(lang)).slice(0, 5);
---

<Base lang={lang} path="/">
  <section class="hero">
    <h1>{t(lang, 'site.title')}</h1>
    <p>{t(lang, 'home.intro')}</p>
  </section>

  <section>
    <h2 class="section-title">{t(lang, 'home.recent')}</h2>
    <PostList lang={lang} views={recent} />
    <p><a href={localePath(lang, '/posts')}>{t(lang, 'home.allPosts')}</a></p>
  </section>
</Base>

<style>
  .hero {
    margin: var(--space-16) 0 var(--space-12);
  }
  .hero h1 {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-3);
  }
  .hero p {
    color: var(--color-muted);
    font-size: var(--text-lg);
    max-width: 36rem;
    margin: 0;
  }
  .section-title {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-2);
  }
</style>
