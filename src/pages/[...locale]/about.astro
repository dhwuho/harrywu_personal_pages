---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { mdxComponents } from '../../components/mdx';
import { localeStaticPaths, t, type Locale } from '../../i18n';
import { getPage } from '../../lib/content';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
const page = await getPage('about', lang);
const Content = page ? (await render(page)).Content : null;
const title = page?.data.title ?? t(lang, 'about.title');
---

<Base lang={lang} path="/about" title={title} description={page?.data.description}>
  <h1 class="page-title">{title}</h1>
  <div class="prose">
    {Content && <Content components={mdxComponents} />}
  </div>
</Base>
