---
import Base from '../../layouts/Base.astro';
import { socialLinks } from '../../config/site';
import { localeStaticPaths, t, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.props as { lang: Locale };
---

<Base lang={lang} path="/links" title={t(lang, 'links.title')} description={t(lang, 'links.description')}>
  <h1 class="page-title">{t(lang, 'links.title')}</h1>
  <p class="page-lead">{t(lang, 'links.description')}</p>
  <ul class="links">
    {
      socialLinks.map((link) => (
        <li>
          <a href={link.url} rel="me noopener" target="_blank">
            <span class="name">{link.name}</span>
            <span class="note">{link.note[lang]}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  a {
    display: grid;
    grid-template-columns: 8rem 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color var(--transition), background var(--transition);
  }
  a:hover {
    border-color: var(--color-accent);
    background: var(--color-surface);
  }
  .name {
    font-weight: 600;
  }
  .note {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .arrow {
    color: var(--color-muted);
  }
  @media (max-width: 480px) {
    a {
      grid-template-columns: 1fr auto;
    }
    .note {
      grid-column: 1;
    }
  }
</style>
