---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { mdxComponents } from '../components/mdx';
import { contentLang, getPage, htmlLang } from '../lib/content';

const page = await getPage('about');
const Content = page ? (await render(page)).Content : null;
const title = page?.data.title ?? 'About';
---

<Base title={title} description={page?.data.description}>
  <div lang={page ? htmlLang[contentLang(page)] : undefined}>
    <h1 class="page-title">{title}</h1>
    <div class="prose">
      {Content && <Content components={mdxComponents} />}
    </div>
  </div>
</Base>
