---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { mdxComponents } from '../../components/mdx';
import { contentLang, formatDate, getPosts, htmlLang, postSlug, tagSlug, type PostEntry } from '../../lib/content';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props as { post: PostEntry };
const { Content } = await render(post);
const { title, description, date, updated, tags, cover, draft } = post.data;
---

<Base title={title} description={description} image={cover} type="article">
  <article lang={htmlLang[contentLang(post)]}>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="meta" lang="en">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span>· Updated {formatDate(updated)}</span>}
        {draft && <span class="tag">Draft</span>}
      </p>
      {
        tags.length > 0 && (
          <p class="tags">
            {tags.map((tag) => (
              <a class="tag" href={`/tags/${tagSlug(tag)}/`}>
                {tag}
              </a>
            ))}
          </p>
        )
      }
    </header>

    <div class="prose">
      <Content components={mdxComponents} />
    </div>
  </article>
</Base>

<style>
  .post-header {
    margin: var(--space-12) 0 var(--space-8);
  }
  h1 {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-2);
  }
  .meta,
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
