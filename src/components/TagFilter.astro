---
interface Props {
  tags: { tag: string; slug: string; count: number }[];
  /** Slug of the selected tag; none means "All". */
  current?: string;
}

const { tags, current } = Astro.props;
---

{
  tags.length > 0 && (
    <nav class="tag-filter" aria-label="Tags">
      <a class="tag" href="/posts/" aria-current={current ? undefined : 'page'}>
        All
      </a>
      {tags.map(({ tag, slug, count }) => (
        <a class="tag" href={`/tags/${slug}/`} aria-current={slug === current ? 'page' : undefined}>
          {tag} <span class="count">{count}</span>
        </a>
      ))}
    </nav>
  )
}

<style>
  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  .count {
    opacity: 0.6;
  }
</style>
