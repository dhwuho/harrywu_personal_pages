---
import { contentLang, formatDate, htmlLang, postSlug, type PostEntry } from '../lib/content';

interface Props {
  posts: PostEntry[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="muted">No posts yet.</p>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li class="reveal">
          <a href={`/posts/${postSlug(post)}/`}>
            <span class="title" lang={htmlLang[contentLang(post)]}>{post.data.title}</span>
            {post.data.draft && <span class="tag">Draft</span>}
          </a>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        </li>
      ))}
    </ul>
  )
}

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  a {
    text-decoration: none;
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
  }
  /* Underline grows in from the left on hover. */
  .title {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 250ms ease, color var(--transition);
  }
  a:hover .title {
    background-size: 100% 1px;
  }
  time {
    flex-shrink: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
