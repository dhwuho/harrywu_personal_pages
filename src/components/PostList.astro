---
import { formatDate, localePath, t, type Locale } from '../i18n';
import type { PostView } from '../lib/content';

interface Props {
  lang: Locale;
  views: PostView[];
}

const { lang, views } = Astro.props;
---

{
  views.length === 0 ? (
    <p class="muted">{t(lang, 'posts.empty')}</p>
  ) : (
    <ul class="post-list">
      {views.map(({ slug, post, postLang, isFallback }) => (
        <li>
          <a href={localePath(lang, `/posts/${slug}`)}>
            <span class="title" lang={isFallback ? postLang : undefined}>
              {post.data.title}
            </span>
            {post.data.draft && <span class="tag">{t(lang, 'post.draft')}</span>}
          </a>
          <time datetime={post.data.date.toISOString()}>{formatDate(lang, post.data.date)}</time>
        </li>
      ))}
    </ul>
  )
}

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }
  a {
    text-decoration: none;
    display: flex;
    gap: var(--space-2);
    align-items: baseline;
  }
  time {
    flex-shrink: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
