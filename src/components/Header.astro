---
import { localePath, locales, t, type Locale, type UiKey } from '../i18n';

interface Props {
  lang: Locale;
  path: string;
}

const { lang, path } = Astro.props;
const other = locales.find((l) => l !== lang)!;

const nav: { key: UiKey; href: string }[] = [
  { key: 'nav.home', href: '/' },
  { key: 'nav.posts', href: '/posts' },
  { key: 'nav.about', href: '/about' },
  { key: 'nav.links', href: '/links' },
];
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`) || (href === '/posts' && path.startsWith('/tags/'));
---

<header class="site-header container">
  <a class="brand" href={localePath(lang, '/')}>{t(lang, 'site.title')}</a>
  <nav aria-label="Main">
    {
      nav.map((item) => (
        <a href={localePath(lang, item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
          {t(lang, item.key)}
        </a>
      ))
    }
    <a class="lang-switch" href={localePath(other, path)} hreflang={other} data-lang={other}>
      {t(lang, 'lang.switch')}
    </a>
  </nav>
</header>

<script is:inline>
  document.querySelector('.lang-switch')?.addEventListener('click', (e) => {
    try {
      localStorage.setItem('lang', e.currentTarget.dataset.lang);
    } catch {}
  });
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-6);
    flex-wrap: wrap;
  }
  .brand {
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--text-sm);
  }
  nav a {
    color: var(--color-muted);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-text);
  }
  .lang-switch {
    padding: 0 var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }
  .lang-switch:hover {
    border-color: var(--color-accent);
    color: var(--color-accent) !important;
  }
</style>
